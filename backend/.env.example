PORT=4000
NODE_ENV=development
# Comma-separated list. Never use * in production.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:5500
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
WHATSAPP_URL=https://wa.me/919105144413

# Google Sheets
# Use the spreadsheet ID from the Google Sheets URL, not the full URL.
GOOGLE_SHEETS_SPREADSHEET_ID=YOUR_SPREADSHEET_ID
GOOGLE_SHEETS_SHEET_NAME=Clients
GOOGLE_SHEETS_BOOKINGS_SHEET_NAME=Bookings
GOOGLE_SHEETS_CONTACTS_SHEET_NAME=Contacts
GOOGLE_SERVICE_ACCOUNT_EMAIL=YOUR_SERVICE_ACCOUNT_EMAIL
# Keep the \n sequences when storing the private key in an environment variable.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
